{
  "name": "skillbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "db:reset": "node server/reset-db.js",
    "docs:build": "npx -y @redocly/cli build-docs openapi.yaml -o docs/index.html && npx -y @redocly/cli bundle openapi.yaml -o docs/openapi.json && node scripts/build-docs.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup.js"
    ]
  }
}

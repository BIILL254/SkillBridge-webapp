# Copy this file to .env and fill it in. .env is listed in .gitignore and must
# NEVER be committed: a key committed to git stays in the history even if you
# delete the file later. This file (.env.example) only holds placeholders.
#
# Vite only exposes variables prefixed with VITE_ to the frontend; everything
# else here stays on the server.

# --- API keys (Week 9) -------------------------------------------------------
# Every request except GET /api/health must send a valid X-API-Key header.
# Make one long random key per consumer (never share one key between several):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# API_KEYS: outside consumers and teammates, written name:key, comma separated.
# Send each partner their own key privately (direct message, not the repo).
API_KEYS=agroconnect:<key-for-agroconnect>,team:<key-for-our-team>
# WEB_API_KEY: the key our own React app sends. VITE_API_KEY must be the same
# value so the frontend can read it. (A browser bundle is public, so this key
# identifies the app; student data is protected by the login, not by this key.)
WEB_API_KEY=<key-for-our-web-app>
VITE_API_KEY=<same-value-as-WEB_API_KEY>

# --- Rate limiting (optional; these are the defaults) ------------------------
# RATE_LIMIT_MAX=100          # requests per window for each partner/team key
# RATE_LIMIT_WEB_MAX=300      # requests per window per visitor address (web app)
# RATE_LIMIT_WINDOW_MS=60000  # window length in milliseconds
# On Render (behind a proxy) set TRUST_PROXY=1 so visitors are told apart by
# their real address. Leave unset locally.
# TRUST_PROXY=1

# --- Frontend -> API address ---------------------------------------------------
VITE_API_URL=http://localhost:3001/api

# Restrict which frontend origin can call this API. Leave unset for local
# dev (permissive); set to your deployed frontend's URL in production.
# ALLOWED_ORIGIN=https://your-frontend.onrender.com

# --- Upstream: Maji Website integration (server/services/majiClient.js) ---
# Leave these unset to run against mock Maji Website data (clearly labeled
# "source": "mock" in API responses). Once Team 4 shares their real API,
# fill these in — no code changes needed.
# MAJI_API_BASE_URL=https://<their-real-host>/api
# MAJI_API_KEY=<the key/token they issue you>

# --- Seeded account passwords (set these when deploying publicly) ---
# The seed data creates an "admin" account and demo students that all default
# to the password 1234. Because free hosts reset the database on restart, these
# get re-created each time. Set ADMIN_PASSWORD to a strong secret on any public
# deployment. SEED_PASSWORD is optional and changes the demo students' password.
# ADMIN_PASSWORD=<a long random password>
# SEED_PASSWORD=<optional>

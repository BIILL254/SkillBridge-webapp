# Copy this file to .env and adjust if your API runs somewhere other than
# localhost:3001. Vite only exposes variables prefixed with VITE_ to the
# frontend — see src/api.js for where this gets read.

VITE_API_URL=http://localhost:3001/api

# --- Upstream: Maji Website integration (server/services/majiClient.js) ---
# Leave these unset to run against mock Maji Website data (clearly labeled
# "source": "mock" in API responses). Once Team 4 shares their real API,
# fill these in — no code changes needed.
# MAJI_API_BASE_URL=https://<their-real-host>/api
# MAJI_API_KEY=<the key/token they issue you>

# Copy this file to .env and adjust if your API runs somewhere other than
# localhost:3001. Vite only exposes variables prefixed with VITE_ to the
# frontend — see src/api.js for where this gets read.

VITE_API_URL=http://localhost:3001/api

# Restrict which frontend origin can call this API. Leave unset for local
# dev (permissive); set to your deployed frontend's URL in production.
# ALLOWED_ORIGIN=https://your-frontend.onrender.com

# --- Upstream: Maji Website integration (server/services/majiClient.js) ---

{
  "openapi": "3.0.3",
  "info": {
    "title": "SkillBridge API",
    "version": "1.0.0",
    "description": "API contract for SkillBridge based on the Week 3 endpoint list. This API provides expert discovery, consultation booking, logistics integration with Maji Website, and delivery tracking.\n Every error response has the shape `{ \"error\": \"<message>\" }`. The /logistics endpoints require a bearer token from POST /auth/login.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {}
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Log in or sign up to get a bearer token"
    },
    {
      "name": "Health",
      "description": "Server status"
    },
    {
      "name": "Experts",
      "description": "Verified expert discovery, profile lookup, availability slots, and reviews"
    },
    {
      "name": "Skills",
      "description": "Categorized skill marketplace catalogue and filterable skill offers"
    },
    {
      "name": "Requests",
      "description": "Consultation booking requests for farmers and skill-exchange requests"
    },
    {
      "name": "Logistics",
      "description": "Upstream logistics integration with Maji Website water stations and delivery orders"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check the server is up",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and receive a bearer token",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Wrong username or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (10 per 15 minutes per IP)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account and receive a bearer token",
        "operationId": "signup",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Username already taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/experts": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return verified expert profiles",
        "operationId": "getExperts",
        "parameters": [
          {
            "name": "estate",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Westlands"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rating",
                "proximity"
              ]
            },
            "example": "rating"
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": -1.286
          },
          {
            "name": "lng",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 36.817
          }
        ],
        "responses": {
          "200": {
            "description": "Experts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Expert"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/experts/{id}": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return detailed expert profile",
        "operationId": "getExpertById",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Expert found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expert"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/skills": {
      "get": {
        "tags": [
          "Skills"
        ],
        "summary": "Return categorized skill offers",
        "operationId": "getSkills",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Agronomy"
          }
        ],
        "responses": {
          "200": {
            "description": "Skills retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Skill"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/experts/{id}/availability": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return expert availability",
        "operationId": "getExpertAvailability",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Available time slots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Availability"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/requests": {
      "post": {
        "tags": [
          "Requests"
        ],
        "summary": "Create a consultation booking request",
        "operationId": "createConsultationRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consultation request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "Expert does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/experts/{id}/reviews": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return expert review summary",
        "operationId": "getExpertReviews",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reviews retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewSummary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/logistics/stations": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Return Maji vendor stations",
        "operationId": "getStations",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "estate",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Westlands",
            "description": "Case-insensitive part of an estate name"
          }
        ],
        "responses": {
          "200": {
            "description": "Stations retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logistics/estates": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Return estates Maji knows about",
        "operationId": "getEstates",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "deliveryStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            },
            "example": "active"
          }
        ],
        "responses": {
          "200": {
            "description": "Estates retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstateList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logistics/estates/{estateId}/driver-interests": {
      "post": {
        "tags": [
          "Logistics"
        ],
        "summary": "Register a driver's interest in an estate",
        "operationId": "registerDriverInterest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Forwards to Maji Website. Not used by the SkillBridge UI today.",
        "parameters": [
          {
            "name": "estateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "est_1042"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverInterestRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Interest registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverInterest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logistics/deliveries/{id}": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Track a delivery (not supported by Maji)",
        "operationId": "getDelivery",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Maji has no delivery tracking, so this always returns 501.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 101
          }
        ],
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "501": {
            "description": "Not implemented by Maji Website",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/logistics/deliveries": {
      "post": {
        "tags": [
          "Logistics"
        ],
        "summary": "Create a delivery order (not supported by Maji)",
        "operationId": "createDelivery",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Maji has no delivery API, so this always returns 501.",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "501": {
            "description": "Not implemented by Maji Website",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token",
        "description": "Bearer token placeholder for Week 9 authentication. Pass 'Authorization: Bearer <token>'. For Week 8, public downstream endpoints accept any placeholder token or open requests.\n"
      }
    },
    "parameters": {
      "ExpertId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "example": 12
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Expert not found"
          }
        }
      },
      "Expert": {
        "type": "object",
        "required": [
          "id",
          "name",
          "estate",
          "rating",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "name": {
            "type": "string",
            "example": "Grace Mwangi"
          },
          "estate": {
            "type": "string",
            "example": "Westlands"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "example": 4.8
          },
          "latitude": {
            "type": "number",
            "example": -1.286
          },
          "longitude": {
            "type": "number",
            "example": 36.817
          },
          "bio": {
            "type": "string",
            "example": "Certified Agronomy mentor."
          }
        }
      },
      "Skill": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "Soil Health"
          },
          "category": {
            "type": "string",
            "example": "Agriculture"
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "date",
          "startTime",
          "durationMinutes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-15"
          },
          "startTime": {
            "type": "string",
            "example": "10:00:00"
          },
          "durationMinutes": {
            "type": "integer",
            "example": 60
          }
        }
      },
      "ConsultationRequest": {
        "type": "object",
        "required": [
          "farmerName",
          "topic",
          "expertId",
          "date"
        ],
        "properties": {
          "farmerName": {
            "type": "string",
            "example": "John Kamau"
          },
          "topic": {
            "type": "string",
            "example": "Irrigation Systems"
          },
          "expertId": {
            "type": "integer",
            "example": 12
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-20T10:00:00Z"
          }
        }
      },
      "RequestResponse": {
        "type": "object",
        "required": [
          "requestId",
          "status"
        ],
        "properties": {
          "requestId": {
            "type": "integer",
            "example": 501
          },
          "status": {
            "type": "string",
            "example": "Pending"
          }
        }
      },
      "ReviewSummary": {
        "type": "object",
        "required": [
          "rating",
          "reviewCount",
          "completedSessions"
        ],
        "properties": {
          "rating": {
            "type": "number",
            "example": 4.9
          },
          "reviewCount": {
            "type": "integer",
            "example": 87
          },
          "completedSessions": {
            "type": "integer",
            "example": 210
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "billamani"
          },
          "password": {
            "type": "string",
            "example": "1234"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "name",
          "username",
          "phone",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Test User"
          },
          "username": {
            "type": "string",
            "example": "testuser"
          },
          "phone": {
            "type": "string",
            "description": "07XXXXXXXX or 01XXXXXXXX",
            "example": "0712345678"
          },
          "password": {
            "type": "string",
            "minLength": 4,
            "example": "s3cret"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Source": {
        "type": "string",
        "enum": [
          "mock",
          "live"
        ],
        "description": "\"mock\" until MAJI_API_BASE_URL is configured",
        "example": "mock"
      },
      "StationList": {
        "type": "object",
        "required": [
          "source",
          "stations"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "stations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vendorId": {
                  "type": "string",
                  "example": "ven_211"
                },
                "stationName": {
                  "type": "string",
                  "example": "Westlands Pickup Station"
                },
                "targetEstateId": {
                  "type": "string",
                  "example": "est_1042"
                }
              }
            }
          }
        }
      },
      "EstateList": {
        "type": "object",
        "required": [
          "source",
          "estates"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "estates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "est_1042"
                },
                "name": {
                  "type": "string",
                  "example": "Westlands, Nairobi"
                },
                "deliveryStatus": {
                  "type": "string",
                  "enum": [
                    "active",
                    "inactive"
                  ],
                  "example": "active"
                }
              }
            }
          }
        }
      },
      "DriverInterestRequest": {
        "type": "object",
        "required": [
          "userId"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "usr_5581"
          },
          "contactMethod": {
            "type": "string",
            "example": "phone"
          }
        }
      },
      "DriverInterest": {
        "type": "object",
        "required": [
          "source",
          "id",
          "userId",
          "estateId",
          "status"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "id": {
            "type": "string",
            "example": "mock_di_1760000000000"
          },
          "userId": {
            "type": "string",
            "example": "usr_5581"
          },
          "estateId": {
            "type": "string",
            "example": "est_1042"
          },
          "status": {
            "type": "string",
            "example": "pending"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
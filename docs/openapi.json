{
  "openapi": "3.0.3",
  "info": {
    "title": "SkillBridge API",
    "version": "1.0.0",
    "description": "API contract for SkillBridge. It provides expert discovery, consultation booking, a skills catalogue and a logistics proxy to Maji Website.\n\n**Authentication.** Every endpoint except `GET /health` requires an API key in the `X-API-Key` header (scheme `apiKeyAuth`). A missing or wrong key returns `401` before the endpoint runs. Endpoints about a person (profile, sessions, admin, logistics, and student swap requests) additionally need the login token from `POST /auth/login` as `Authorization: Bearer <token>` (scheme `bearerAuth`).\n\n**Rate limit.** 100 requests per minute per API key (our own web app: 300 per minute per visitor address). Going over returns `429` with a `Retry-After` header (seconds) and a JSON body.\n\n**Errors.** Every error response has the shape `{ \"error\": \"<message>\" }` (the `429` also has `retryAfter`).",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Log in or sign up to get a bearer token"
    },
    {
      "name": "Health",
      "description": "Server status"
    },
    {
      "name": "Experts",
      "description": "Verified expert discovery, profile lookup, availability slots, and reviews"
    },
    {
      "name": "Skills",
      "description": "Categorized skill marketplace catalogue and filterable skill offers"
    },
    {
      "name": "Requests",
      "description": "Consultation booking requests for farmers and skill-exchange requests"
    },
    {
      "name": "Logistics",
      "description": "Upstream logistics integration with Maji Website water stations and delivery orders"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check the server is up",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and receive a bearer token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Wrong username or password. Also returned (with \"Missing or invalid API key\") when the X-API-Key header is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (10 per 15 minutes per IP)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account and receive a bearer token",
        "operationId": "signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Username already taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/experts": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return verified expert profiles",
        "operationId": "getExperts",
        "parameters": [
          {
            "name": "estate",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Westlands"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rating",
                "proximity"
              ]
            },
            "example": "rating"
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": -1.286
          },
          {
            "name": "lng",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 36.817
          }
        ],
        "responses": {
          "200": {
            "description": "Experts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Expert"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/experts/{id}": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return detailed expert profile",
        "operationId": "getExpertById",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Expert found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expert"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/skills": {
      "get": {
        "tags": [
          "Skills"
        ],
        "summary": "Return categorized skill offers",
        "operationId": "getSkills",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Agronomy"
          }
        ],
        "responses": {
          "200": {
            "description": "Skills retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Skill"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/experts/{id}/availability": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return expert availability",
        "operationId": "getExpertAvailability",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Available time slots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Availability"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/requests": {
      "post": {
        "tags": [
          "Requests"
        ],
        "summary": "Create a consultation booking request",
        "operationId": "createConsultationRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consultation request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Expert does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Two shapes share this path. A consultation booking (expertId, farmerName, topic, date) needs only the API key. A student swap or coin request (type \"swap\" or \"coin\") also needs the login token (bearerAuth)."
      }
    },
    "/experts/{id}/reviews": {
      "get": {
        "tags": [
          "Experts"
        ],
        "summary": "Return expert review summary",
        "operationId": "getExpertReviews",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reviews retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/logistics/stations": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Return Maji vendor stations",
        "operationId": "getStations",
        "security": [
          {
            "apiKeyAuth": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "estate",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Westlands",
            "description": "Case-insensitive part of an estate name"
          }
        ],
        "responses": {
          "200": {
            "description": "Stations retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/logistics/estates": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Return estates Maji knows about",
        "operationId": "getEstates",
        "security": [
          {
            "apiKeyAuth": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "deliveryStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            },
            "example": "active"
          }
        ],
        "responses": {
          "200": {
            "description": "Estates retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstateList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/logistics/estates/{estateId}/driver-interests": {
      "post": {
        "tags": [
          "Logistics"
        ],
        "summary": "Register a driver's interest in an estate",
        "operationId": "registerDriverInterest",
        "security": [
          {
            "apiKeyAuth": [],
            "bearerAuth": []
          }
        ],
        "description": "Forwards to Maji Website. Not used by the SkillBridge UI today.",
        "parameters": [
          {
            "name": "estateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "est_1042"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverInterestRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Interest registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverInterest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/logistics/deliveries/{id}": {
      "get": {
        "tags": [
          "Logistics"
        ],
        "summary": "Track a delivery (not supported by Maji)",
        "operationId": "getDelivery",
        "security": [
          {
            "apiKeyAuth": [],
            "bearerAuth": []
          }
        ],
        "description": "Maji has no delivery tracking, so this always returns 501.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 101
          }
        ],
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "501": {
            "description": "Not implemented by Maji Website",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/logistics/deliveries": {
      "post": {
        "tags": [
          "Logistics"
        ],
        "summary": "Create a delivery order (not supported by Maji)",
        "operationId": "createDelivery",
        "security": [
          {
            "apiKeyAuth": [],
            "bearerAuth": []
          }
        ],
        "description": "Maji has no delivery API, so this always returns 501.",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "501": {
            "description": "Not implemented by Maji Website",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Per-consumer API key, sent in the X-API-Key header on every request except GET /health. Keys are issued privately, one per consumer. Never share or commit a real key; use <your-api-key> as a placeholder."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque session token",
        "description": "Login token returned by POST /auth/login, sent as \"Authorization: Bearer <token>\". Sent IN ADDITION to the API key on endpoints that act on a logged-in student."
      }
    },
    "parameters": {
      "ExpertId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "example": 12
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key (X-API-Key), or on a student endpoint a missing/expired login token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "badKey": {
                "summary": "Missing or wrong API key",
                "value": {
                  "error": "Missing or invalid API key"
                }
              },
              "noLogin": {
                "summary": "Valid key but no login token on a student endpoint",
                "value": {
                  "error": "Not logged in"
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded: more than 100 requests per minute for this API key.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RateLimitError"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Expert not found"
          }
        }
      },
      "Expert": {
        "type": "object",
        "required": [
          "id",
          "name",
          "estate",
          "rating",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "name": {
            "type": "string",
            "example": "Grace Mwangi"
          },
          "estate": {
            "type": "string",
            "example": "Westlands"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "example": 4.8
          },
          "latitude": {
            "type": "number",
            "example": -1.286
          },
          "longitude": {
            "type": "number",
            "example": 36.817
          },
          "bio": {
            "type": "string",
            "example": "Certified Agronomy mentor."
          }
        }
      },
      "Skill": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "Soil Health"
          },
          "category": {
            "type": "string",
            "example": "Agriculture"
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "date",
          "startTime",
          "durationMinutes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-15"
          },
          "startTime": {
            "type": "string",
            "example": "10:00:00"
          },
          "durationMinutes": {
            "type": "integer",
            "example": 60
          }
        }
      },
      "ConsultationRequest": {
        "type": "object",
        "required": [
          "farmerName",
          "topic",
          "expertId",
          "date"
        ],
        "properties": {
          "farmerName": {
            "type": "string",
            "example": "John Kamau"
          },
          "topic": {
            "type": "string",
            "example": "Irrigation Systems"
          },
          "expertId": {
            "type": "integer",
            "example": 12
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-20T10:00:00Z"
          }
        }
      },
      "RequestResponse": {
        "type": "object",
        "required": [
          "requestId",
          "status"
        ],
        "properties": {
          "requestId": {
            "type": "integer",
            "example": 501
          },
          "status": {
            "type": "string",
            "example": "Pending"
          }
        }
      },
      "ReviewSummary": {
        "type": "object",
        "required": [
          "rating",
          "reviewCount",
          "completedSessions"
        ],
        "properties": {
          "rating": {
            "type": "number",
            "example": 4.9
          },
          "reviewCount": {
            "type": "integer",
            "example": 87
          },
          "completedSessions": {
            "type": "integer",
            "example": 210
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "billamani"
          },
          "password": {
            "type": "string",
            "example": "1234"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "name",
          "username",
          "phone",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Test User"
          },
          "username": {
            "type": "string",
            "example": "testuser"
          },
          "phone": {
            "type": "string",
            "description": "07XXXXXXXX or 01XXXXXXXX",
            "example": 712345678
          },
          "password": {
            "type": "string",
            "minLength": 4,
            "example": "s3cret"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Source": {
        "type": "string",
        "enum": [
          "mock",
          "live"
        ],
        "description": "\"mock\" until MAJI_API_BASE_URL is configured",
        "example": "mock"
      },
      "StationList": {
        "type": "object",
        "required": [
          "source",
          "stations"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "stations": {
